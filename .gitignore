# 운영체제 생성 파일
.DS_Store
docs/

# 사용자 정의 백업 폴더
images/_backup-*/

# Jekyll/Bundler artifacts
.bundle/
.venv/
node_modules/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
_site/
vendor/

# Supabase local project state
supabase/.temp/

# 로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 환경 변수 파일 (API 키 등 민감 정보 포함)
.env*
!.env.example
!.env.sample
.dev.vars
.npmrc
.netrc

# 비밀 키/인증서/자격 증명 파일
*.pem
*.key
*.p8
*.p12
*.crt
*.csr
id_rsa
id_ed25519
credentials.*
secrets.*
service-account*.json
firebase-adminsdk*.json

# DB 덤프 및 로컬 데이터 파일
*.dump
*.backup
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# IDE 및 에디터 설정
.vscode/
.idea/
.history/

# 임시 파일
*.tmp
